# Copy to deploy/.env for Compose; only the providers selected in config need credentials.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
ORCAROUTER_API_KEY=
# Custom providers: add the variable named by llm.providers.<name>.api_key_env.

# MinerU is used only for PDF input with pipeline.pdf_backend: mineru.
MINERU_API_KEY=

# Local application development; Compose overrides the service connection URLs.
DATABASE_URL=postgresql://wenyi:wenyi@localhost:5432/wenyi
REDIS_URL=redis://localhost:6379/0
DATA_DIR=./data
WENYI_CONFIG=config.yaml

# Compose host file path, relative to deploy/; mounted in all backend services.
WENYI_CONFIG_FILE=../config.yaml
INSTALL_PDF_OUTPUT=true

# Optional token: HTTP Bearer authentication and WebSocket first-message {"token":"..."}.
# The Web UI sends the initial authentication message automatically.
WENYI_API_TOKEN=
WENYI_CORS_ORIGINS=*
