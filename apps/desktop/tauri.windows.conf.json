{
  "bundle": {
    "targets": ["nsis"],
    "windows": {
      "allowDowngrades": false,
      "nsis": {
        "installMode": "currentUser",
        "template": "installer.nsi",
        "languages": ["English", "SimpChinese"],
        "displayLanguageSelector": true,
        "installerHooks": "installer.nsh"
      }
    }
  }
}
