{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  // One checking program: app source plus the Vite/Playwright configs and the
  // shared sandbox modules they import, so no composite emit can shadow a
  // source file (tsc -b stays a pure noEmit check; vite build needs no emit).
  "include": [
    "src",
    "vite.config.ts",
    "playwright.config.ts",
    "../../packages/ui/vite.shared.ts",
    "../../packages/ui/sandbox/fixtures.ts",
    "../../packages/ui/sandbox/scenarios.ts",
    "../../packages/ui/sandbox/progress-frames.ts",
    "../../packages/ui/sandbox/progress-server.ts",
    "../../packages/ui/sandbox/mock-platform.tsx"
  ]
}
