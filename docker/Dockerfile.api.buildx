# syntax=docker/dockerfile:1
# Optional cached variant; keep installation steps aligned with Dockerfile.api.
# Shared API/worker image. Targets: api | worker
# Set INSTALL_PDF_OUTPUT=false for a smaller image without WeasyPrint/fpdf2.
# Only the Web dependency closure is installed; runtime contains no workspace sources.

ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.12.15
FROM ${UV_IMAGE} AS uv

FROM python:3.12-slim AS builder

ARG INSTALL_PDF_OUTPUT=true
ARG UV_DEFAULT_INDEX=https://pypi.org/simple

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/app/.venv \
    TIKTOKEN_CACHE_DIR=/app/.venv/share/tiktoken \
    UV_DEFAULT_INDEX=${UV_DEFAULT_INDEX} \
    PATH="/app/.venv/bin:$PATH" \
    WENYI_CONFIG=/app/config.yaml

WORKDIR /app

COPY --from=uv /uv /uvx /bin/

COPY pyproject.toml uv.lock ./
COPY packages/core packages/core
COPY packages/backend packages/backend
COPY apps/api apps/api
# uv parses workspace metadata, but neither package is installed or copied to runtime.
COPY packages/cli/pyproject.toml packages/cli/pyproject.toml
COPY apps/desktop/backend/pyproject.toml apps/desktop/backend/pyproject.toml

# The Docker context excludes Git metadata; release builds supply WENYI_VERSION.
ARG WENYI_VERSION=0.0.0+docker

RUN --mount=type=cache,id=wenyi-uv-cache,target=/root/.cache/uv,sharing=locked \
    export SETUPTOOLS_SCM_PRETEND_VERSION="$WENYI_VERSION" \
    && if [ "$INSTALL_PDF_OUTPUT" = "true" ]; then \
      uv sync --frozen --package wenyi-api --no-dev --no-editable --extra pdf-output --extra pdf-output-lite \
        --reinstall-package wenyi-core --reinstall-package wenyi-backend --reinstall-package wenyi-api; \
    else \
      uv sync --frozen --package wenyi-api --no-dev --no-editable \
        --reinstall-package wenyi-core --reinstall-package wenyi-backend --reinstall-package wenyi-api; \
    fi \
    && uvicorn --version \
    && arq --version \
    && python -c "import tiktoken; from wenyi_core.ingest.tokens import ENCODING_NAME; tiktoken.get_encoding(ENCODING_NAME)" \
    && python -c "import wenyi_api, wenyi_backend, wenyi_core; from importlib.util import find_spec; assert all(find_spec(name) is None for name in ('wenyi_desktop', 'wenyi_cli', 'keyring', 'PyInstaller'))"

FROM python:3.12-slim AS base

ARG DEBIAN_MIRROR=
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    TIKTOKEN_CACHE_DIR=/app/.venv/share/tiktoken \
    PATH="/app/.venv/bin:$PATH" \
    WENYI_CONFIG=/app/config.yaml
WORKDIR /app

# Debian 12/13 slim images use /etc/apt/sources.list.d/debian.sources.
RUN if [ -n "$DEBIAN_MIRROR" ]; then \
      sed -i -E "s#https?://deb\.debian\.org#${DEBIAN_MIRROR}#g" /etc/apt/sources.list.d/debian.sources; \
    fi

RUN rm -f /etc/apt/apt.conf.d/docker-clean

RUN --mount=type=cache,id=wenyi-apt-cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,id=wenyi-apt-lists,target=/var/lib/apt/lists,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates \
      libxml2 libxslt1.1 libpango-1.0-0 libpangoft2-1.0-0 libharfbuzz-subset0 \
      fonts-noto-core fonts-noto-cjk fonts-wqy-zenhei fonts-dejavu-core fontconfig

COPY --from=builder /app/.venv /app/.venv
COPY config.yaml ./

FROM base AS api
EXPOSE 8000
CMD ["uvicorn", "wenyi_api.main:app", "--host", "0.0.0.0", "--port", "8000"]

FROM base AS worker
CMD ["arq", "wenyi_api.workers.WorkerSettings"]
