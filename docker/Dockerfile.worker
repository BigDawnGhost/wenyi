# Shared API/worker dependencies. Set INSTALL_PDF_OUTPUT=false for a smaller image.
FROM python:3.12-slim

ARG INSTALL_PDF_OUTPUT=true
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/app/.venv \
    PATH="/app/.venv/bin:$PATH" \
    WENYI_CONFIG=/app/config.yaml
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libxml2 libxslt1.1 libpango-1.0-0 libpangoft2-1.0-0 libharfbuzz-subset0 \
    fonts-noto-core fonts-noto-cjk fonts-wqy-zenhei fonts-dejavu-core fontconfig \
    && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir uv

COPY pyproject.toml uv.lock ./
COPY packages/core packages/core
COPY packages/cli packages/cli
COPY apps/api apps/api
COPY config.yaml ./
RUN if [ "$INSTALL_PDF_OUTPUT" = "true" ]; then \
      uv sync --frozen --all-packages --no-dev --extra pdf-output --extra pdf-output-lite; \
    else uv sync --frozen --all-packages --no-dev; fi

CMD ["arq", "wenyi_api.workers.WorkerSettings"]
