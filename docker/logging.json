{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "default": {
      "()": "wenyi_core.observability.JsonFormatter"
    }
  },
  "handlers": {
    "console": {
      "()": "wenyi_core.observability.console_handler",
      "service": "wenyi-api",
      "formatter": "default",
      "stream": "ext://sys.stderr"
    }
  },
  "root": {
    "handlers": ["console"],
    "level": "INFO"
  }
}
