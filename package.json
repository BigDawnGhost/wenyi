{
  "name": "wenyi-monorepo",
  "private": true,
  "description": "Frontend tooling for the Wenyi workspace.",
  "scripts": {
    "dev:web": "pnpm -C apps/web dev",
    "build:web": "pnpm -C apps/web build",
    "docs:dev": "vitepress dev docs --host 127.0.0.1 --port 5175 --strictPort",
    "docs:build": "pnpm test:docs && vitepress build docs",
    "docs:preview": "vitepress preview docs --host 127.0.0.1 --port 4175 --strictPort",
    "test:docs": "node --test docs/.vitepress/docs.test.mjs",
    "dev:desktop-ui": "pnpm -C apps/desktop/frontend dev",
    "build:desktop-ui": "pnpm -C apps/desktop/frontend build",
    "test:frontend-boundaries": "node --test \"packages/ui/tests/*.test.mjs\"",
    "desktop": "node scripts/dev/desktop.mjs dev",
    "desktop:build": "node scripts/dev/desktop.mjs build",
    "dev:api": "uv run uvicorn wenyi_api.main:app --reload --port 8000",
    "dev:worker": "uv run arq wenyi_api.workers.WorkerSettings",
    "gen:schema": "node scripts/contract/schema.mjs --write",
    "check:schema": "node scripts/contract/schema.mjs --check",
    "build": "pnpm build:web"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.0",
    "github-slugger": "^2.0.0",
    "openapi-typescript": "^7.4.4",
    "vitepress": "^1.6.4"
  }
}
