"""Signatures of the private PyO3 document engine shipped with Core."""

from collections.abc import Callable, Iterator, Sequence
from os import PathLike

_Path = str | PathLike[str]
_Slot = tuple[str, str]

def xhtml_tokens(markup: str) -> list[tuple[int, str, list[tuple[str, str]] | None]] | None: ...
def peek(path: _Path) -> str: ...
def ingest(
    path: _Path, source_lang: str, target_lang: str, epub_schema: int | None = None
) -> bytes: ...
def export(source: _Path, destination: _Path, options: bytes) -> list[str]: ...
def render_resources(source: _Path, options: bytes) -> tuple[list[tuple[str, str]], list[str]]: ...
def render_html_bodies(
    source: _Path, options: bytes, mime_types: dict[str, str]
) -> tuple[list[str], list[str]]: ...
def generate(
    destination: _Path, options: bytes, assets: Sequence[tuple[str, str, bytes, bool]]
) -> None: ...
def append_about(source: _Path, destination: _Path, page: str) -> bool: ...
def parse_docx(
    path: _Path, title: str, source_path: str, source_lang: str, target_lang: str
) -> bytes: ...
def write_docx(destination: _Path, header: bytes, chapters: Iterator[bytes]) -> None: ...
def parse_fb2(
    content: str, fallback: str, path: str, source_lang: str, target_lang: str
) -> bytes: ...
def fb2_title(content: str, fallback: str) -> str: ...
def fb2_binaries(content: str) -> list[tuple[str, str, str]]: ...
def parse_text(content: str) -> list[tuple[tuple[str, int] | None, list[str]]]: ...
def write_text(
    destination: _Path,
    chapters: Sequence[Sequence[tuple[str, str, str, int]]],
    bilingual: bool,
    source_first: bool,
    markdown: bool,
) -> None: ...
def html_normalize_text(raw: str, offsets: Sequence[int]) -> tuple[str, list[int]]: ...
def html_regions(
    nodes: Sequence[tuple[int, bool, bool, bool]],
) -> list[tuple[int, bool, list[int]]]: ...
def html_annotate_document(
    html: str, chapter_tags: Sequence[str], rebuild_shell: bool
) -> tuple[bytes, str] | None: ...
def html_backfill_plain(
    template: str, edits: Sequence[tuple[str, str, str, _Slot | None, bool]]
) -> str | None: ...
def html_backfill_paired(
    template: str,
    edits: Sequence[tuple[str, str, str, bool, _Slot | None, str | None]],
    source_first: bool,
    preserve_style: bool,
    source_lang: str,
) -> str | None: ...
def html_present(html: str, language: str, style_id: str, css: str) -> str | None: ...
def html_inline_media(html: str, load: Callable[[str], tuple[str, bytes] | None]) -> str | None: ...
def mineru_prepare_chunks(source: _Path, directory: _Path, max_pages: int) -> int | None: ...

class PdfInspection:
    def __init__(self, path: _Path) -> None: ...
    @property
    def page_count(self) -> int: ...
    def image_only(self, indices: Sequence[int]) -> bool | None: ...
    def outline(self) -> list[tuple[int, str, int]] | None: ...

class PdfSpreadSource:
    @property
    def page_count(self) -> int: ...

def pdf_spread_source(source: bytes) -> PdfSpreadSource | str: ...
def pdf_write_spreads(
    source: PdfSpreadSource, fillback: _Path, indices: Sequence[int], source_first: bool
) -> str | None: ...
